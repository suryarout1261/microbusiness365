# ==============================================================================
# MicroBusiness365 Cloud SaaS Environment Configuration
# ==============================================================================

# Supabase Public Keys (Client & Server)
# Obtain from: Supabase Project Dashboard -> Project Settings -> API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server Admin Key (NEVER expose to client bundles)
# Used for server-side payment verification and webhook processing
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Payment Gateway Keys
# Obtain from: Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
