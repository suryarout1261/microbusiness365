---
import '../styles/global.css';

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="description" content="MicroBusiness365 — simple business tools for sales, inventory, customers, invoices, and expenses. No sign-in, no ads, local-first." />
    <meta name="keywords" content="invoice generator, receipt generator, sales calculator, inventory manager, small business tools, GST calculator, ROI calculator" />
    <meta property="og:title" content="MicroBusiness365 — Simple tools for small businesses" />
    <meta property="og:description" content="Manage sales, inventory, customers, expenses, and invoices with no account required." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="MicroB" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} — MicroBusiness365` : 'MicroBusiness365'}</title>
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('mb365-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.classList.toggle('dark', saved === 'dark');
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-[var(--color-surface)] text-[var(--color-text-primary)] antialiased">
    <slot />
  </body>
</html>
