---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Inventory"><div class="max-w-5xl mx-auto p-6"><h1 class="text-2xl font-bold mb-2">Inventory</h1><p class="text-neutral-400 mb-6">Products, stock, low-stock alerts.</p><div class="rounded-xl border border-neutral-800 bg-neutral-950 p-8 text-center"><h3 class="text-lg font-medium">No products yet</h3><p class="text-sm text-neutral-500 mt-1">Add products to manage stock and sales.</p><button onclick="alert('Add product — Dexie ready')" class="mt-4 px-4 py-2 bg-white text-black rounded text-sm">Add Product</button></div></div></Layout>
