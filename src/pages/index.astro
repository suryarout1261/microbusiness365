---
import Layout from "../layouts/Layout.astro";
import LandingHeader from "../components/shared/LandingHeader";
import HeroSection from "../components/shared/HeroSection";
import LandingFeatures from "../components/shared/LandingFeatures";
import ToolsGrid from "../components/shared/ToolsGrid";
import LandingFooter from "../components/shared/LandingFooter";
---
<Layout title="Free Small Business Management Software & App — All-in-One Offline Tool">
  <LandingHeader client:load />
  <main>
    <HeroSection client:load />
    <LandingFeatures client:load />
    <ToolsGrid client:load />
    <section id="about" class="py-24 bg-gradient-to-b from-gray-50 dark:from-[#0c0c0f] to-white dark:to-[#0a0a0a]">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">All-in-One Small Business Management Software</h2>
        <p class="text-gray-500 dark:text-neutral-400 leading-relaxed mb-4">
          MicroBusiness365 is a 100% free, offline, no-sign-up <strong>micro business management software</strong> designed for retail shops, traders, freelancers, and growing enterprises. Experience complete control over your business with our <strong>small business invoicing software</strong>, <strong>small business inventory management software</strong>, <strong>expense management</strong>, and <strong>customer sales & payment tracking software</strong>.
        </p>
        <p class="text-gray-500 dark:text-neutral-400 leading-relaxed">
          Your data is stored locally in your browser — zero cloud tracking, zero subscription fees, and complete offline availability. Built for owners who need a fast, reliable <strong>business management system and tool</strong> without the complexity of traditional ERPs.
        </p>
      </div>
    </section>
  </main>
  <LandingFooter />
</Layout>