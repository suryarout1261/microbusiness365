---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Purchases"><div class="max-w-5xl mx-auto p-6"><h1 class="text-2xl font-bold mb-2">Purchases</h1><p class="text-neutral-400 mb-6">Track what you buy from suppliers.</p><div class="rounded-xl border border-neutral-800 bg-neutral-950 p-8 text-center"><h3 class="text-lg font-medium">No purchases yet</h3><p class="text-sm text-neutral-500 mt-1">Record purchases to increase inventory and track supplier balances.</p><button onclick="alert('New purchase — Dexie ready')" class="mt-4 px-4 py-2 bg-white text-black rounded text-sm">New Purchase</button></div></div></Layout>
