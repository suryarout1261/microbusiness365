---
import Layout from '../../layouts/Layout.astro';
import AppShell from '../../components/app/AppShell';
import LandingHeader from '../../components/shared/LandingHeader';
---
<Layout title="Payments">
  <LandingHeader client:load />
  <AppShell pathname={Astro.url.pathname}>
  
  <div class="flex min-h-screen bg-[var(--color-surface)] dark:bg-[#0a0a0a]">
    <main class="flex-1 min-w-0">

        <div class="mx-auto max-w-6xl">
          <div class="max-w-5xl px-6 pt-8 pb-16">
            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-300 mb-4">Payments</span>
            <h1 class="text-[32px] md:text-4xl font-extrabold tracking-tight text-[var(--color-text-primary)] dark:text-white mb-4">Payments</h1>
            <p class="text-base text-[var(--color-text-secondary)] dark:text-neutral-400 leading-relaxed mb-2 max-w-3xl">Track incoming payments, partial payments, and remaining balances.</p>
            <p class="text-base text-[var(--color-text-secondary)] dark:text-neutral-400 leading-relaxed max-w-3xl">Keep cash-flow accurate with a clear view of what is received and what is owed.</p>
          </div>
        </div>
  <div class="mx-auto max-w-6xl"><div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-raised)] p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-[var(--color-text-primary)] mb-4">Payments</h2>
      <p class="text-sm text-[var(--color-text-muted)]">Connected to Dexie payments table for sales and purchases. Full manager available in development.</p>
    </div>
  </div></div>
    </main>
  </div>
  </AppShell>
</Layout>
