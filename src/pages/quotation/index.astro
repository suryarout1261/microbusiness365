---
import Layout from '../../layouts/Layout.astro';
import AppShell from '../../components/app/AppShell';
import LandingHeader from '../../components/shared/LandingHeader';
import QuotationManager from '../../components/shared/QuotationManager';
---
<Layout title="Quotations">
  <LandingHeader client:load />
  <AppShell pathname={Astro.url.pathname}>
  
  <div class="flex min-h-screen bg-[var(--color-surface)] dark:bg-[#0a0a0a]">
    <main class="flex-1 min-w-0">

        <div class="mx-auto max-w-6xl">
          <div class="max-w-5xl px-6 pt-8 pb-16">
            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-300 mb-4">Quotations</span>
            <h1 class="text-[32px] md:text-4xl font-extrabold tracking-tight text-[var(--color-text-primary)] dark:text-white mb-4">Quotations</h1>
            <p class="text-base text-[var(--color-text-secondary)] dark:text-neutral-400 leading-relaxed mb-2 max-w-3xl">Prepare customer quotes with pricing, terms, and delivery estimates.</p>
            <p class="text-base text-[var(--color-text-secondary)] dark:text-neutral-400 leading-relaxed max-w-3xl">Win more work with clear, professional quotes that set the right expectations.</p>
          </div>
        </div>
  <div class="mx-auto max-w-6xl"><div class="max-w-5xl mx-auto p-6">
    <QuotationManager client:load />
  </div>
    </main>
  </div>
  </AppShell>
</Layout>
