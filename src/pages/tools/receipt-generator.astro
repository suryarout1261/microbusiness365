import LandingFooter from '../../components/shared/LandingFooter';
import LandingHeader from '../../components/shared/LandingHeader';

import ReceiptGenerator from '../../components/tools/generators/ReceiptGenerator';
---
<Layout title="Receipt Generator - MicroBusiness365">
  <LandingHeader client:load />
  
  <main class="w-full pt-24 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl xl:max-w-6xl 2xl:max-w-7xl w-full">
      <ReceiptGenerator client:load />
    </div>
  </main>
  
  <LandingFooter />
