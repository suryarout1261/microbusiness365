<AppLayout title="Tools — MicroBusiness365">
  <div class="space-y-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--color-text-primary)] dark:text-white mb-2">Business Tools</h1>
